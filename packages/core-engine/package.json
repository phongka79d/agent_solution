{
  "name": "@agentos/core-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./canonical-json": {
      "types": "./dist/durability/canonical-json.d.ts",
      "import": "./dist/durability/canonical-json.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "node ../../scripts/eslint.mjs",
    "test:unit": "vitest run --config vitest.config.ts && node --test test/env.validator.test.mjs test/readiness.test.mjs",
    "test:contracts": "vitest run --config vitest.contracts.config.ts",
    "test:adversarial": "vitest run --config vitest.adversarial.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts"
  },
  "dependencies": {
    "@agentos/database": "workspace:*",
    "@agentos/second-brain": "workspace:*",
    "ioredis": "^5.4.1",
    "@opentelemetry/api": "^1.8.0"
  },
  "devDependencies": {
    "@agentos/typescript-config": "workspace:*",
    "@agentos/eslint-config": "workspace:*",
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
