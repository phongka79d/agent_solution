{
  "name": "agent-solution-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:contracts": "turbo run test:contracts",
    "test:adversarial": "turbo run test:adversarial",
    "test:security": "turbo run test:security",
    "test:pilots": "turbo run test:pilots",
    "test:e2e": "turbo run test:e2e",
    "test:ui": "playwright test -c tests/ui/stub/playwright.config.ts",
    "test:ui:stack": "node tests/ui/run-stack.mjs",
    "db:migrate:rehearse": "turbo run db:migrate:rehearse",
    "check:migrations": "node scripts/check-migration-numbering.mjs",
    "test:rls-rehearsal": "pnpm --filter @agentos/database test:rls-rehearsal",
    "test:rls-policies": "vitest run --config packages/database/vitest.rls.config.ts",
    "test:p5-db": "vitest run --config packages/database/vitest.p5.config.ts",
    "test:integration": "node --test tests/integration/care-pilot-smoke.mjs tests/integration/sales-pilot-smoke.mjs tests/integration/p4-cross-domain-smoke.mjs",
    "test:stack": "node --test --test-global-setup=tests/stack/global-setup.mjs --test-concurrency=1 \"tests/stack/**/*.stack.test.mjs\"",
    "test:stack:db": "node tests/stack/run-db.mjs",
    "test:chaos": "node --test --test-global-setup=tests/stack/global-setup.mjs --test-concurrency=1 \"tests/stack/chaos/**/*.stack.test.mjs\"",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "demo:up": "node scripts/demo/up.mjs",
    "demo:down": "node scripts/demo/down.mjs",
    "demo:preflight": "node scripts/demo/preflight.mjs --offline",
    "demo:preflight:live": "node scripts/demo/preflight.mjs --live",
    "demo:seed": "node scripts/demo/seed.mjs",
    "demo:smoke": "node scripts/demo/smoke.mjs --offline",
    "demo:smoke:live": "node scripts/demo/smoke.mjs --live",
    "check:demo-boundary": "node scripts/check-demo-boundary.mjs",
    "live:preflight": "node scripts/live/preflight.mjs",
    "live:up": "node scripts/live/preflight.mjs && node scripts/demo/up.mjs --profile live",
    "test:live": "node scripts/live/run-tests.mjs",
    "live:reset": "node scripts/live/reset.mjs",
    "live:scan": "node scripts/live/scan-artifacts.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@agentos/eslint-config": "workspace:*",
    "@agentos/typescript-config": "workspace:*",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.52.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^1.13.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
