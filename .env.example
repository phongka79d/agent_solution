# =============================================================================
# Local/CI placeholders only. Copy to .env (gitignored) before docker compose.
# Never commit .env. Never put production credentials in this file.
#
# APP_ENV selects the deployment profile: local|ci|staging|sandbox|production.
# NODE_ENV is the Node runtime mode only: development|test|production.
# Mapping: local→development, ci→test, staging|sandbox|production→production.
# A missing APP_ENV refuses startup. NODE_ENV never selects the profile.
# Placeholder and banner values are rejected outside local/CI.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
APP_ENV=local
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
WEB_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=debug
SERVICE_NAME=agentos-api
# Set to false to drop Qdrant from the readiness gate.
KNOWLEDGE_ANSWERS_ENABLED=true

# --- Security (local placeholders; fail closed in staging/sandbox/production) ---
JWT_SECRET=super_secret_jwt_encryption_key_min_32_characters_long
JWT_EXPIRES_IN=24h
INTERNAL_API_KEY=agentos_internal_service_mesh_key_64_characters_min
WEBHOOK_HMAC_SECRET=hmac_signature_validation_secret_for_external_webhooks
AUDIT_HMAC_SECRET=local_only_audit_chain_signing_placeholder
ENCRYPTION_KEY_AES256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- PostgreSQL (host-side URL; Compose rewrites the host to postgres) ---
POSTGRES_DB=agentos_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_secret_password
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_ENV=local
APP_ROLE_PASSWORD=agentos_app_password
MIGRATOR_ROLE_PASSWORD=agentos_migrator_password
DATABASE_URL=postgresql://agentos_app:agentos_app_password@localhost:5432/agentos_dev?schema=agentos
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Managed tiers only. Must include sslmode=verify-full. Leave unset locally.
# POSTGRES_PRIMARY_URL=
# POSTGRES_REPLICA_URL=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret_password
REDIS_DB=0
REDIS_KEY_PREFIX=agentos:
SESSION_MUTEX_TTL_SECONDS=30
IDEMPOTENCY_TTL_SECONDS=259200

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=qdrant_dev_secret_api_key
QDRANT__SERVICE__HTTP_PORT=6333
QDRANT__SERVICE__GRPC_PORT=6334
QDRANT__SERVICE__ENABLE_CORS=true
# QDRANT__SERVICE__API_KEY is not set here: docker-compose.yml derives it from
# QDRANT_API_KEY (one anchored value for qdrant, api, and worker). Setting both
# apart is refused by the validator, so only QDRANT_API_KEY is a variable.
EMBEDDING_MODEL_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Workflow engine (off unless --profile workflows and this address is set) ---
# TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_CORS_ORIGINS=http://localhost:3000

# --- LLM (local placeholder; not a live provider credential) ---
OPENAI_API_KEY=mock-openai-key
# ANTHROPIC_API_KEY is optional and must not be defaulted.
DEFAULT_LLM_PROVIDER=openai
PRIMARY_REASONING_MODEL=gpt-4o
FAST_COMPLETION_MODEL=gpt-4o-mini
MAX_TOKENS_PER_RUN=4096
LLM_REQUEST_TIMEOUT_MS=15000

# --- SoR boundary. MOCK_ERP_ENABLED=true is legal only for local/ci. ---
MOCK_ERP_ENABLED=true
MOCK_ERP_PORT=8081
MOCK_SECRET_KEY=mock_erp_hmac_secret_key
SIMULATE_LATENCY_MS=50
SIMULATE_FAILURE_RATE=0.0
ERP_API_BASE_URL=http://localhost:8081/api/v1
ERP_CLIENT_ID=agentos_client_id
ERP_CLIENT_SECRET=agentos_client_secret
ERP_TIMEOUT_MS=5000
EVENT_INGESTION_BASE_URL=http://localhost:8081/events/v1
EVENT_INGESTION_HMAC_SECRET=event_stream_validation_secret

# Optional adapters are omitted so an incomplete credential set cannot enable them.
# Set a whole set, or leave the whole set unset. Do not invent production values here.
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_WEBHOOK_SIGNING_KEY=
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_WEBHOOK_SIGNING_KEY=
# ECPAY_MERCHANT_ID=
# ECPAY_HASH_KEY=
# ECPAY_HASH_IV=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=no-reply@example.invalid
PAYPAL_MODE=sandbox

# --- Object storage (s3 is the safe default; local is local/CI only) ---
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://s3.ap-northeast-1.amazonaws.com
STORAGE_BUCKET=agentos-assets-dev
STORAGE_ACCESS_KEY_ID=mock_s3_access_key
STORAGE_SECRET_ACCESS_KEY=mock_s3_secret_key
STORAGE_REGION=ap-northeast-1

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agentos-revenue-platform
METRICS_PORT=9090
COST_PER_1K_PROMPT_TOKENS_GPT4O=0.005
COST_PER_1K_COMPLETION_TOKENS_GPT4O=0.015
COST_PER_1K_PROMPT_TOKENS_MINI=0.00015
COST_PER_1K_COMPLETION_TOKENS_MINI=0.0006

# --- Command Center (origin only; never append /api/v1; no database credential) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super_secret_jwt_encryption_key_min_32_characters_long
NEXT_PUBLIC_API_URL=http://localhost:4000
WORKER_HEALTH_PORT=4001
