# syntax=docker/dockerfile:1
# apps/worker image. Build context is the repository root:
#   docker build -f docker/Dockerfile.worker .
# No secret is passed at build time; runtime configuration comes from the
# environment of the deployment (01 §8). The worker exposes no port.

FROM node:20-bookworm-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV CI=true

RUN corepack enable

WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps ./apps

RUN pnpm install --frozen-lockfile \
    && pnpm --filter @agentos/worker... build

FROM node:20-bookworm-slim AS runtime

ENV NODE_ENV=production

WORKDIR /repo

# Workspace symlinks under node_modules/@agentos resolve inside /repo, so the
# packages directory ships alongside the worker's compiled output.
COPY --from=builder /repo/node_modules ./node_modules
COPY --from=builder /repo/packages ./packages
COPY --from=builder /repo/package.json ./package.json
COPY --from=builder /repo/apps/worker ./apps/worker

# The health sidecar (`apps/worker/src/server.mjs`) is plain Node source, not
# TypeScript output: it imports the shared boot module from the gateway, so both
# files ship at their repo-relative paths for `node apps/worker/dist/index.js`.
COPY --from=builder /repo/apps/api/src/server.mjs ./apps/api/src/server.mjs
COPY --from=builder /repo/apps/api/src/probes.mjs ./apps/api/src/probes.mjs

USER node

CMD ["node", "apps/worker/dist/index.js"]
