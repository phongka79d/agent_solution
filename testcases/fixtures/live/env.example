# Live sandbox placeholders for testcases/live/*.example - NOT a credential file and NOT an
# approval. Copy to env.local (gitignored) and fill with approved sandbox values.
#
# Required before any live case: an approved ASM-001 connector lock. Without it, live cases are
# SKIP_ASM_001. Nothing here is validated by the generator: the file existing proves nothing.

# ASM-001 approved connector lock (path to the owner-approved lock document)
LIVE_CONNECTORS_LOCK=

# Sandbox endpoints and tenant
LIVE_BASE_URL=https://sandbox.api.invalid
LIVE_ERP_BASE_URL=https://sandbox.erp.invalid
LIVE_TENANT_ID=
LIVE_ALLOWLIST_HOSTS=sandbox.api.invalid,sandbox.erp.invalid

# Credentials are read from the process environment, never from this file
# LIVE_ERP_TOKEN=  (set in the shell, do not store here)

# Approved sandbox identities (logical fixture handle -> sandbox id)
LIVE_CUSTOMER_A_SANDBOX_ID=
LIVE_CUSTOMER_B_SANDBOX_ID=
LIVE_CUSTOMER_A_CONTACT=sandbox-a@example.invalid
LIVE_CUSTOMER_B_CONTACT=sandbox-b@example.invalid
LIVE_SKU_OK=
LIVE_SKU_ZERO=
LIVE_ORDER_A=
LIVE_ORDER_B=

# Channel used by live journeys (API-003 connector names)
LIVE_CHAT_CHANNEL=WEB_APP_CHAT

# Local results/receipts directory; gitignored, never committed
LIVE_RESULTS_DIR=results/

# Every live case creates its own records under a unique run id and deletes only those in cleanup.
